---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Page not found" noindex>
  <section class="wrap page-head">
    <div class="head center" style="margin-bottom:0">
      <p class="eyebrow">404</p>
      <h1 class="display">This page <em>isn’t here.</em></h1>
      <p class="lead">The link may be old, or the page may have moved.</p>
      <div class="row"><a class="btn solid" href="/posts/">Read the posts <Icon name="right" /></a><a class="btn" href="/">Go home</a></div>
    </div>
  </section>
</Base>
