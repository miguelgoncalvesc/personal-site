---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---
<Base title="Say hi" description="Tell me what you’re building and where it’s stuck. Questions, disagreements with a post, or a story from your own team.">
  <section class="wrap page-head">
    <div class="head center" style="margin-bottom:0">
      <p class="eyebrow">Say hi</p>
      <h1 class="display">Tell me what <em>you’re building.</em></h1>
      <p class="lead">Questions, disagreements with a post, or a story from your own team. Tell me what you need and how I can help.</p>
      <ContactForm />
    </div>
  </section>
</Base>
