---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Icon from "../../components/Icon.astro";
import { category, getPosts } from "../../lib/posts";

const posts = await getPosts();
const description = "Thoughts on AI automation, observability, CI/CD, and scaling engineering teams.";
const categories = [...new Set(posts.map(category))];
const countOf = (name: string) => posts.filter((post) => category(post) === name).length;
const plural = (n: number) => `${n} post${n === 1 ? "" : "s"}`;
---
<Base title="Posts" description={description}>
  <section class="wrap page-head">
    <div class="head center">
      <p class="eyebrow">Posts</p>
      <h1 class="display">Notes from <em>production.</em></h1>
      <p class="lead">{description}</p>
      <label class="search"><Icon name="search" /><span class="sr-only">Search posts</span><input id="postSearch" type="search" placeholder="Search posts" autocomplete="off" /></label>
      <div class="row" id="filters" role="group" aria-label="Filter by category">
        <button class="chip" type="button" aria-pressed="true" data-category="">All<i>{posts.length}</i></button>
        {categories.map((name) => <button class="chip" type="button" aria-pressed="false" data-category={name}>{name}<i>{countOf(name)}</i></button>)}
      </div>
      <p class="eyebrow" id="count">{plural(posts.length)}</p>
    </div>
    <div class="grid" id="postsGrid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <p class="lead empty" id="noPosts" hidden>No posts match that search. Try fewer or different words.</p>
  </section>
</Base>

<script>
  const filters = document.getElementById("filters");
  const search = document.getElementById("postSearch") as HTMLInputElement | null;
  const count = document.getElementById("count");
  const empty = document.getElementById("noPosts");
  const cards = [...document.querySelectorAll<HTMLElement>("#postsGrid .card")];
  let wanted = "";
  // Full post text, fetched the first time the search box is used.
  let bodies: Record<string, string> | null = null;

  function apply() {
    const terms = (search?.value ?? "").toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const text = `${card.dataset.search ?? ""} ${bodies?.[card.dataset.id ?? ""] ?? ""}`;
      const matches = (wanted === "" || card.dataset.category === wanted) && terms.every((term) => text.includes(term));
      card.hidden = !matches;
      if (matches) shown++;
    }
    if (count) count.textContent = `${shown} post${shown === 1 ? "" : "s"}`;
    if (empty) empty.hidden = shown > 0;
  }

  filters?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest("button");
    if (!button) return;
    wanted = button.dataset.category ?? "";
    filters.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
    apply();
  });

  search?.addEventListener("input", apply);
  search?.addEventListener(
    "focus",
    async () => {
      try {
        bodies = await (await fetch("/posts/search.json")).json();
        apply();
      } catch {
        // Titles, descriptions and tags still match without the full text.
      }
    },
    { once: true },
  );
</script>
