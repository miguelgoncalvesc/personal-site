---
import { Image } from "astro:assets";
import { category, coverOf, formatDate, readingTime, type Post } from "../lib/posts";
interface Props { post: Post }
const { post } = Astro.props;
const cover = coverOf(post);
// Matched by the search box on /posts.
const searchText = [post.data.title, post.data.description, category(post), ...post.data.tags].join(" ").toLowerCase();
---
<a class="card" href={`/posts/${post.id}/`} data-category={category(post)} data-id={post.id} data-search={searchText}>
  {cover ? (
    <div class="cover"><Image src={cover} alt="" width={900} loading="lazy" /></div>
  ) : (
    <div class="cover type"><span>{post.data.coverPhrase ?? category(post)}</span></div>
  )}
  <h3>{post.data.title}</h3>
  <p class="eyebrow">{category(post)} • {formatDate(post.data.date)} • {readingTime(post)} min</p>
</a>
